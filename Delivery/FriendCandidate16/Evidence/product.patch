+        if(shadowQuery && !HLGIShadowOwnerAllowed((uint)i,cullingMask,shadowRenderingLayers,useRenderingLayers)) continue;
+#if defined(HLGI_INLINE_RT) || defined(HLGI_SOFTWARE_TRIANGLES)
+        if (HLGIHardwareHasMesh(i)) continue;
+#endif

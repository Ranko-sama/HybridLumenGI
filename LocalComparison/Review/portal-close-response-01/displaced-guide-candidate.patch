+// The cached direction is a radiance-weighted guide, not a proven light path.
+// If a rigid object jumped across that direction, prefer a new known estimate
+// at this patch. Unscheduled and unknown updates still retain the old value.
+bool HLGIDisplacedPoseInGuide(float3 position,float4 guide)
+{
+    if(guide.w<=0 || dot(guide.xyz,guide.xyz)<0.5) return false;
+    [loop] for(int i=0;i<_HLGI_ChangeCount;i++)
+    {
+        HLGIChangeRegion region=_HLGI_ChangeRegions[i];
+        if(region.minimum.w==1 && region.receiver.y>0 &&
+            HLGIBvhBounds(position,guide.xyz,region.minimum.xyz,region.maximum.xyz,_HLGI_MaxDistance)) return true;
+    }
+    return false;
+}
